<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher orb's whole frame: the painted picture (wgt_visual), and over it the
    invisible touch zones whose layout weights carve the widget into the very
    proportions WidgetRenderer paints. Under everything sits wgt_orb — one full-size
    zone that opens the app; every layer above it is click-through wherever it carries
    no click of its own.

    The pinned row's size depends on how many pins it holds (a crowded row squeezes),
    so the layout keeps a prepared row per count — wgt_pins_1 .. wgt_pins_5 — and the
    provider shows exactly the one matching the paint. The rows' weights spell the
    same shares WidgetRenderer.PinRow does: a margin off the top-left corner, then the
    tiles with small gaps between them. The connect button's corner stays as it was,
    its zone carved around the hitbox's bottom-right corner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- fitCenter, not fitXY: the host's size is an estimate, and when the real box
         drifts from it, fitXY would squash the circles into ellipses on resize.
         fitCenter shrinks the whole picture a uniform step instead — the orb stays
         round whatever the launcher reports. -->
    <ImageView
        android:id="@+id/wgt_visual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- The base layer: open the app from wherever nothing more specific sits. -->
    <FrameLayout
        android:id="@+id/wgt_orb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The connect button's zone: the hitbox's bottom-right corner. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="707" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="293"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="707" />

            <ImageView
                android:id="@+id/wgt_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="293" />
        </LinearLayout>
    </LinearLayout>

    <!-- One pin. -->
    <LinearLayout
        android:id="@+id/wgt_pins_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="23"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />

            <ImageView
                android:id="@+id/wgt_pin_1_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="73" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="73" />
    </LinearLayout>

    <!-- Two pins. -->
    <LinearLayout
        android:id="@+id/wgt_pins_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="23"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />

            <ImageView
                android:id="@+id/wgt_pin_2_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_2_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="48" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="73" />
    </LinearLayout>

    <!-- Three pins. -->
    <LinearLayout
        android:id="@+id/wgt_pins_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="23"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />

            <ImageView
                android:id="@+id/wgt_pin_3_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_3_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_3_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="73" />
    </LinearLayout>

    <!-- Four pins — the row starts to squeeze. -->
    <LinearLayout
        android:id="@+id/wgt_pins_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="21.5"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />

            <ImageView
                android:id="@+id/wgt_pin_4_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="21.5" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_4_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="21.5" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_4_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="21.5" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_4_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="21.5" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="74.5" />
    </LinearLayout>

    <!-- Five pins — the row at its tightest. -->
    <LinearLayout
        android:id="@+id/wgt_pins_5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16.8"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />

            <ImageView
                android:id="@+id/wgt_pin_5_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16.8" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_5_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16.8" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_5_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16.8" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_5_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16.8" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/wgt_pin_5_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16.8" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="79.2" />
    </LinearLayout>
</FrameLayout>
