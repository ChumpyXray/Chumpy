<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher orb's whole frame: the painted picture (wgt_visual) under invisible
    touch zones, every zone its own view pinned to the frame's edges — the button at
    the bottom-right corner, the pin slots along the top-left. The provider frames
    each zone to the exact pixel box WidgetRenderer paints (setViewLayoutWidth and
    friends, Android 12+); the sizes and margins below are only the static fallback
    a pre-12 launcher inflates before the first frame arrives.

    fitCenter on the picture: the host's size is an estimate, and when the real box
    drifts from it the picture shrinks a uniform step instead of deforming — the
    orb stays round whatever the launcher reports.

    Under everything sits wgt_orb — one full-size zone that opens the app; the zones
    themselves carry no visuals at all, so wherever one holds no click of its own the
    tap falls through to it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wgt_visual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- The base layer: open the app from wherever nothing more specific sits. -->
    <FrameLayout
        android:id="@+id/wgt_orb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The connect button's zone, pinned to the bottom-right corner. -->
    <ImageView
        android:id="@+id/wgt_button"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@null" />

    <!-- The pinned slots' zones, along the top-left corner, one per slot. -->
    <ImageView
        android:id="@+id/wgt_pin_0"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wgt_pin_1"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="45dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wgt_pin_2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="84dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wgt_pin_3"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="123dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wgt_pin_4"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="162dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null" />
</FrameLayout>
