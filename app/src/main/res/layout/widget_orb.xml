<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher orb's whole frame: the painted picture (wgt_visual), and over it the
    invisible touch zones whose layout weights carve the widget into the very
    proportions WidgetRenderer paints — a fifth of the height for the pin row with five
    equal cells, the bottom-right corner's 29% for the connect button, the rest opening
    the app. The zones carry no visuals at all; the bitmap is the only thing seen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wgt_visual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The pinned squares' row: five equal cells along the top edge. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wgt_tile_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wgt_tile_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wgt_tile_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wgt_tile_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wgt_tile_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- The orb's own zone, with the connect button's corner carved out. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="80"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wgt_orb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="707" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="293"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="634" />

                <ImageView
                    android:id="@+id/wgt_button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="366" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
